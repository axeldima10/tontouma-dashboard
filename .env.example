# --- Mode d'authentification ---------------------------------------------------
# dev = Clerk désactivé, utilisateurs fictifs (pastille « Mode développement »).
# Refusé par `next build` / production. Laisser vide pour utiliser Clerk.
AUTH_MODE=

# --- Clerk (identité, organisations, rôles) ------------------------------------
# Publique : peut atteindre le navigateur.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secrète : serveur uniquement.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Le jeton de session Clerk doit contenir (Dashboard Clerk → Sessions → Customize session token) :
#   { "platform_role": "{{user.public_metadata.role}}" }
# L'équipe Tontouma a public_metadata.role = "SUPER_ADMIN" (même règle que le backend).
# L'identifiant et le rôle d'organisation sont déjà présents dans le jeton v2 (o.id, o.rol).
# Rôles d'organisation attendus : org:super_admin, org:admin.

# --- Backend Spring Boot ------------------------------------------------------
# Serveur uniquement. Vide = backend fictif de développement (lib/data/mock).
API_BASE_URL=
# Source des données : api | mock. Vide = api si API_BASE_URL est défini, sinon mock.
# `mock` permet de travailler hors réseau en gardant l'URL du backend ci-dessus (refusé en production).
# Une pastille « Données de démonstration » s'affiche alors dans la barre du haut.
DATA_SOURCE=
# Appels directs du navigateur au backend (CORS à autoriser pour l'origine du tableau de bord) :
# téléversement des documents et endpoints publics de l'assistant (« Tester l'assistant »).
# Même valeur qu'API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=

# --- Backend fictif (ignoré si API_BASE_URL est défini) -------------------------
# normal | empty | error | expired | suspended
FIXTURE_SCENARIO=normal

# --- Sentry (phase 8) ---------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
